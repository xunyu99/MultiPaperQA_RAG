# ============================================================
# 复制成 .env 后填自己的值（.env 不进 git）
#   copy .env.example .env
# ============================================================

# ---------- 规划通道：DashScope / Qwen（结构化路由 + 查询改写）----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLANNER_MODEL=qwen-flash
# DASHSCOPE_PROXY=http://127.0.0.1:7890

# ---------- 生成通道：DeepSeek（正文回答 + 看图）----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
# 本机如果需要走代理才填，不要照抄旧项目里的内网地址
# LLM_PROXY=http://127.0.0.1:7890
# 关思考模式的参数写法：先跑 scripts/check_thinking.py 探测，再把结论填这里
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# ---------- 向量模型（复用 DASHSCOPE_API_KEY）----------
EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_LOCAL_MODEL=BAAI/bge-m3

RERANK_ENABLED=true
RERANK_PROVIDER=local_bge             # local_bge | none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
MODEL_CACHE_DIR=E:/agent/MultiPaperQA_RAG/storage/models

# ---------- MinerU 解析（base_url / 模型版本以控制台文档为准，Step 4 核对）----------
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
# 国内直连一般不用代理；要走就填 http://127.0.0.1:7890
# MINERU_PROXY=http://127.0.0.1:7890
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_POLL_TIMEOUT_SECONDS=900

# ---------- 存储 ----------
STORAGE_DIR=E:/agent/MultiPaperQA_RAG/storage
DB_PATH=E:/agent/MultiPaperQA_RAG/storage/app.db

# ---------- 切分 ----------
CHUNK_TARGET_TOKENS=800
CHUNK_MAX_TOKENS=1200
CHUNK_MIN_TOKENS=200
BLOCK_OVERLAP=0                 # chunk 之间不重叠（边界落在完整块之间，不需要缝合）
TEXT_OVERLAP_CHARS=150          # 只有被切开的长正文块内部带这么多字符的句子级 overlap

# ---------- 检索 ----------
CANDIDATE_K=50                  # 召回候选数（送进 rerank）
TOP_K=5                         # 单篇 / 全库返回几条（试过 3：Recall 60%，比 5 条掉两道题）
PER_PAPER_K=3                   # 多篇时每篇几条（总数 = 篇数 x 3；只给 2 会被重复章节吃光）
SECTION_CAP=0                   # 同章节去重上限，0 = 关（见 BACKLOG B22）
RRF_K=60
RERANK_TOP_K=5
