# ============================================================
# 复制成 .env 后填自己的值（.env 不进 git）
#   copy .env.example .env
# ============================================================

# ---------- 模型服务：DashScope / 百炼（OpenAI 兼容模式）----------
DASHSCOPE_API_KEY=sk-在这里填你的key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本机如果需要走代理才填，不要照抄旧项目里的内网地址
# HTTPS_PROXY=
# HTTP_PROXY=

# ---------- 模型（按角色分工，详见 PLAN.md 第 2 节）----------
LLM_MODEL=qwen-plus
PLANNER_MODEL=qwen-flash
VLM_MODEL=qwen-vl-max

EMBEDDING_PROVIDER=dashscope          # dashscope | local
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8

RERANK_ENABLED=true
RERANK_PROVIDER=local_bge             # local_bge | none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
MODEL_CACHE_DIR=E:/agent/Agentic_RAG/storage/models

# ---------- MinerU 解析（base_url / 模型版本以控制台文档为准，Step 4 核对）----------
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_POLL_TIMEOUT_SECONDS=900

# ---------- 存储 ----------
STORAGE_DIR=E:/agent/Agentic_RAG/storage
DB_PATH=E:/agent/Agentic_RAG/storage/app.db

# ---------- 切分 ----------
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_MIN_TOKENS=120
BLOCK_OVERLAP=1                 # 块级 overlap：带上一个 chunk 的最后 N 个原子块

# ---------- 检索 ----------
CANDIDATE_K=50                  # 召回候选数（送进 rerank）
TOP_K=5                         # 最终进生成上下文的 chunk 数
RRF_K=60
RERANK_TOP_K=5
